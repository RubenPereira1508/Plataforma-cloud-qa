{
  "consumer": {
    "name": "loja-frontend"
  },
  "interactions": [
    {
      "description": "um pedido para criar um produto com nome vazio",
      "pending": false,
      "request": {
        "body": {
          "content": {
            "nome": "",
            "preco": 5
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/produtos"
      },
      "response": {
        "status": 422
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "um pedido para criar um produto válido",
      "pending": false,
      "request": {
        "body": {
          "content": {
            "nome": "Produto do Pact",
            "preco": 9.99
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.nome": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.preco": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/produtos"
      },
      "response": {
        "body": {
          "content": {
            "id": 1,
            "nome": "Caneta",
            "preco": 12.5
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.nome": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.preco": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "um pedido para listar os produtos",
      "pending": false,
      "providerStates": [
        {
          "name": "existe pelo menos um produto"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/produtos"
      },
      "response": {
        "body": {
          "content": [
            {
              "id": 1,
              "nome": "Caneta",
              "preco": 12.5
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].nome": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].preco": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "loja-api"
  }
}